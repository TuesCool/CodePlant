# Web 控制台与 API 监听配置（手机浏览器访问 http://127.0.0.1:8787 ；局域网电脑可改为 0.0.0.0）
SERVER_HOST=127.0.0.1
SERVER_PORT=8787
WEB_ACCESS_TOKEN=

# Android Portal APK 本地通道配置
PORTAL_BASE_URL=http://127.0.0.1:18788
PORTAL_TOKEN=codeplant-dev-token

# 数据目录（待办、每日计划、周复盘、归档会话、自定义模型配置）
DATA_DIR=./data

# 上下文滚动压缩阈值（40~95 百分比）
COMPACTION_THRESHOLD_PERCENT=75
COMPACTION_KEEP_RECENT_MESSAGES=6
